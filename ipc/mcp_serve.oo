// # Model Context Protocol (MCP) Stdio Server for ooastdiff
//
// Logline: JSON-RPC 2.0 stdio server providing AST syntax comparison and token inspection tools.
//
// Setup: Demands FsReadCap for stdio streaming and file reading. Operates without ambient authority.
//
// Beats:
//   1. Process incoming JSON-RPC 2.0 requests over standard input.
//   2. Dispatch initialize, tools/list, and tools/call methods.
//   3. Stream structured capability-bounded responses back to client.

import "core/ast_token.oo";
import "core/tokenizer.oo";
import "core/diff_result.oo";
import "core/lcs_diff.oo";
import "render/diff_theme.oo";
import "ipc/json_field.oo";

fn resolve_content(fs: &FsReadCap, args: String, src_key: String, path_key: String) -> String {
    let src: String = json_get_string(args, src_key);
    if chars_len(src) > 0 {
        return src;
    }
    let path: String = json_get_string(args, path_key);
    if chars_len(path) > 0 {
        let r: Result[String, String] = read_file(fs, path);
        return match r { Ok(s) => s, Err(_) => "" };
    }
    return "";
}

pub fn run_mcp_server(fs: &FsReadCap) {
    let mut running: Bool = true;
    while running {
        let line_res: Result[String, String] = oo_read_stdin_chunk(fs, 8192);
        if !line_res.is_ok() {
            running = false;
        } else {
            let line: String = match line_res { Ok(s) => s, Err(_) => "" };
            let trimmed: String = str_trim(line);
            if chars_len(trimmed) == 0 {
                running = false;
            } else {
                let id: String = json_get_field(trimmed, "id");
                let method: String = json_get_string(trimmed, "method");

                if method == "initialize" {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"protocolVersion\":\"2024-11-05\"," +
                        "\"serverInfo\":{\"name\":\"ooastdiff\",\"version\":\"0.2.0\"}," +
                        "\"capabilities\":{\"tools\":{}}}}";
                    println(resp);
                } else if method == "notifications/initialized" {
                    // ack
                } else if method == "tools/list" {
                    let t1: String = "{\"name\":\"astdiff_compare\",\"description\":\"Compare two source code files or snippets ignoring whitespace and comments\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path_a\":{\"type\":\"string\"},\"path_b\":{\"type\":\"string\"},\"source_a\":{\"type\":\"string\"},\"source_b\":{\"type\":\"string\"}}}}";
                    let t2: String = "{\"name\":\"astdiff_tokenize\",\"description\":\"Tokenize source code or file into semantic AST tokens\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"source\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"}}}}";
                    let t3: String = "{\"name\":\"astdiff_check_identity\",\"description\":\"Verify whether two sources or files are semantically identical\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path_a\":{\"type\":\"string\"},\"path_b\":{\"type\":\"string\"},\"source_a\":{\"type\":\"string\"},\"source_b\":{\"type\":\"string\"}}}}";
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"tools\":[" + t1 + "," + t2 + "," + t3 + "]}}";
                    println(resp);
                } else if method == "tools/call" {
                    let params: String = json_get_field(trimmed, "params");
                    let tool_name: String = json_get_string(params, "name");
                    let args: String = json_get_field(params, "arguments");

                    if tool_name == "astdiff_compare" {
                        let text_a: String = resolve_content(fs, args, "source_a", "path_a");
                        let text_b: String = resolve_content(fs, args, "source_b", "path_b");
                        let tok_a: List[AstToken] = tokenize_source(text_a);
                        let tok_b: List[AstToken] = tokenize_source(text_b);
                        let report: AstDiffReport = diff_tokens(tok_a, tok_b);
                        let j: String = render_report_json(report);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "astdiff_tokenize" {
                        let text: String = resolve_content(fs, args, "source", "path");
                        let tokens: List[AstToken] = tokenize_source(text);
                        let mut j: String = "[";
                        let n: Int = list_len(tokens);
                        let mut i: Int = 0;
                        while i < n {
                            if i > 0 { j = j + ","; }
                            let t: AstToken = list_get(tokens, i);
                            j = j + render_token_json(t);
                            i = i + 1;
                        }
                        j = j + "]";
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "astdiff_check_identity" {
                        let text_a: String = resolve_content(fs, args, "source_a", "path_a");
                        let text_b: String = resolve_content(fs, args, "source_b", "path_b");
                        let tok_a: List[AstToken] = tokenize_source(text_a);
                        let tok_b: List[AstToken] = tokenize_source(text_b);
                        let report: AstDiffReport = diff_tokens(tok_a, tok_b);
                        let is_ident: String = if report.is_identical { "true" } else { "false" };
                        let j: String = "{\"identical\":" + is_ident + ",\"additions\":" + to_string(report.additions) + ",\"deletions\":" + to_string(report.deletions) + "}";
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else {
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                        println(resp);
                    }
                } else {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"error\":{\"code\":-32601,\"message\":\"Unsupported method\"}}";
                    println(resp);
                }
            }
        }
    }
}
